FROM ubuntu:20.04

# Установка необходимых пакетов
RUN apt-get update && apt-get install -y \
    build-essential \
    g++ \
    cmake \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Установка рабочей директории
WORKDIR /app

# Копирование исходных файлов
COPY . .

# Компиляция приложения
RUN g++ -std=c++17 -O2 -o event2dot_v2 *.cpp

# Создание файла отчета
RUN echo '{"slowest_func_v0": "addAnnotatedEdge", "slowest_func_v1": "getNode", "slowest_func_v2": "addEdge"}' > report

# Установка прав на выполнение
RUN chmod +x event2dot_v2

# Команда по умолчанию (может быть переопределена при запуске)
CMD ["./event2dot_v2"]